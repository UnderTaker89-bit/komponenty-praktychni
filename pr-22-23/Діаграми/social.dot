digraph G { graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Професійна соціальна мережа — мікросервіси",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; browser [label="Веб і мобільні клієнти"];gateway [label="API Gateway"];auth [label="Ідентифікація"];profiles [label="Профілі і підписки"];posts [label="Публікації та стрічка"];chat [label="Повідомлення"];queue [shape=cylinder,label="Брокер подій"];db1 [shape=cylinder,label="БД профілів"];db2 [shape=cylinder,label="БД публікацій"];db3 [shape=cylinder,label="БД повідомлень"];browser->gateway [label="HTTPS / WebSocket"];gateway->auth;gateway->profiles;gateway->posts;gateway->chat;profiles->db1;posts->db2;chat->db3;posts->queue [label="подія"];queue->profiles [label="оновлення індексу"]; }
