digraph G { graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Інтернет магазин — UML класи",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; Customer [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Customer</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: string</TD></TR><TR><TD ALIGN="LEFT">+placeOrder(): Order</TD></TR></TABLE>>];Order [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Order</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-status: OrderStatus</TD></TR><TR><TD ALIGN="LEFT">+total(): decimal<BR ALIGN="LEFT"/>+confirm(): void</TD></TR></TABLE>>];OrderItem [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">OrderItem</TD></TR><TR><TD ALIGN="LEFT">-quantity: int<BR ALIGN="LEFT"/>-unitPrice: decimal</TD></TR><TR><TD ALIGN="LEFT">+subtotal(): decimal</TD></TR></TABLE>>];Product [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Product</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: string<BR ALIGN="LEFT"/>-price: decimal</TD></TR><TR><TD ALIGN="LEFT">+reserve(qty: int): bool</TD></TR></TABLE>>];Payment [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Payment</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-amount: decimal<BR ALIGN="LEFT"/>-status: PaymentStatus</TD></TR><TR><TD ALIGN="LEFT">+pay(): bool</TD></TR></TABLE>>];Customer->Order [dir=none,label="1              0..*"];Order->OrderItem [dir=both,arrowtail=diamond,arrowhead=none,label="1              1..*"];Product->OrderItem [dir=none,label="1               0..*"];Order->Payment [dir=none,label="1              0..*"]; }
