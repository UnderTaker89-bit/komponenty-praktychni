digraph G { graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Управління студентами — UML класи",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; Person [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Person</TD></TR><TR><TD ALIGN="LEFT">#id: int<BR ALIGN="LEFT"/>#name: string</TD></TR><TR><TD ALIGN="LEFT">+getName(): string</TD></TR></TABLE>>];Student [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Student</TD></TR><TR><TD ALIGN="LEFT">-recordBook: string</TD></TR><TR><TD ALIGN="LEFT">+enroll(course: Course): Enrollment</TD></TR></TABLE>>];Instructor [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Instructor</TD></TR><TR><TD ALIGN="LEFT">-department: string</TD></TR><TR><TD ALIGN="LEFT">+assignGrade(e: Enrollment): void</TD></TR></TABLE>>];Course [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Course</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: string<BR ALIGN="LEFT"/>-capacity: int</TD></TR><TR><TD ALIGN="LEFT">+hasSeat(): bool</TD></TR></TABLE>>];Enrollment [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Enrollment</TD></TR><TR><TD ALIGN="LEFT">-enrolledAt: Date<BR ALIGN="LEFT"/>-grade: decimal?</TD></TR><TR><TD ALIGN="LEFT">+withdraw(): void</TD></TR></TABLE>>];Department [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Department</TD></TR><TR><TD ALIGN="LEFT">-name: string</TD></TR><TR><TD ALIGN="LEFT">+addInstructor(i: Instructor): void</TD></TR></TABLE>>];Student->Person [arrowhead=empty];Instructor->Person [arrowhead=empty];Department->Instructor [dir=both,arrowtail=odiamond,arrowhead=none,label="0..1               0..*"];Instructor->Course [dir=none,label="1                 0..*"];Student->Enrollment [dir=none,label="1                  0..*"];Course->Enrollment [dir=none,label="1                 0..*"]; }
