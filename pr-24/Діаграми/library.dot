digraph G { graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Бібліотека — UML класи",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; Author [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Author</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: string</TD></TR><TR><TD ALIGN="LEFT">+getBooks(): List&lt;Book&gt;</TD></TR></TABLE>>];Book [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Book</TD></TR><TR><TD ALIGN="LEFT">-isbn: string<BR ALIGN="LEFT"/>-title: string</TD></TR><TR><TD ALIGN="LEFT">+isAvailable(): bool</TD></TR></TABLE>>];LibraryUser [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">LibraryUser</TD></TR><TR><TD ALIGN="LEFT">-id: int<BR ALIGN="LEFT"/>-name: string</TD></TR><TR><TD ALIGN="LEFT">+borrow(copy: BookCopy): Loan</TD></TR></TABLE>>];BookCopy [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">BookCopy</TD></TR><TR><TD ALIGN="LEFT">-inventoryId: int<BR ALIGN="LEFT"/>-status: CopyStatus</TD></TR><TR><TD ALIGN="LEFT">+markLoaned(): void</TD></TR></TABLE>>];Loan [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Loan</TD></TR><TR><TD ALIGN="LEFT">-issuedAt: Date<BR ALIGN="LEFT"/>-dueAt: Date<BR ALIGN="LEFT"/>-returnedAt: Date?</TD></TR><TR><TD ALIGN="LEFT">+close(): void</TD></TR></TABLE>>];Author->Book [dir=none,label="0..*                 1..*"];Book->BookCopy [dir=none,label="1                 0..*"];LibraryUser->Loan [dir=none,label="1               0..*"];BookCopy->Loan [dir=none,label="1                 0..*"]; }
