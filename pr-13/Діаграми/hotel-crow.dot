digraph G { graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Готель — ER модель Вороняча лапка",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; Guest [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Guest</TD></TR><TR><TD ALIGN="LEFT">GuestId PK : int<BR ALIGN="LEFT"/>FullName : string<BR ALIGN="LEFT"/>Phone : string<BR ALIGN="LEFT"/>Email : string</TD></TR></TABLE>>];RoomType [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">RoomType</TD></TR><TR><TD ALIGN="LEFT">RoomTypeId PK : int<BR ALIGN="LEFT"/>Name : string<BR ALIGN="LEFT"/>BaseRate : decimal<BR ALIGN="LEFT"/>DiscountPercent : decimal</TD></TR></TABLE>>];Room [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Room</TD></TR><TR><TD ALIGN="LEFT">RoomId PK : int<BR ALIGN="LEFT"/>RoomTypeId FK : int<BR ALIGN="LEFT"/>Number : string UNIQUE<BR ALIGN="LEFT"/>Capacity : int</TD></TR></TABLE>>];Stay [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Stay</TD></TR><TR><TD ALIGN="LEFT">StayId PK : int<BR ALIGN="LEFT"/>GuestId FK : int<BR ALIGN="LEFT"/>RoomId FK : int<BR ALIGN="LEFT"/>CheckIn : date<BR ALIGN="LEFT"/>CheckOut : date<BR ALIGN="LEFT"/>RateSnapshot : decimal<BR ALIGN="LEFT"/>DiscountSnapshot : decimal</TD></TR></TABLE>>];Service [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">Service</TD></TR><TR><TD ALIGN="LEFT">ServiceId PK : int<BR ALIGN="LEFT"/>Name : string<BR ALIGN="LEFT"/>UnitPrice : decimal</TD></TR></TABLE>>];StayService [shape=plain,label=<<TABLE BORDER="0" CELLBORDER="1" CELLSPACING="0" CELLPADDING="9"><TR><TD ALIGN="LEFT">StayService</TD></TR><TR><TD ALIGN="LEFT">StayServiceId PK : int<BR ALIGN="LEFT"/>StayId FK : int<BR ALIGN="LEFT"/>ServiceId FK : int<BR ALIGN="LEFT"/>Quantity : decimal<BR ALIGN="LEFT"/>UnitPriceSnapshot : decimal</TD></TR></TABLE>>];RoomType->Room [dir=both,arrowtail=teetee,arrowhead=crowodot,label="тип",taillabel="1",headlabel="0..N",labeldistance=2];Guest->Stay [dir=both,arrowtail=teetee,arrowhead=crowodot,label="відвідування",taillabel="1",headlabel="0..N",labeldistance=2];Room->Stay [dir=both,arrowtail=teetee,arrowhead=crowodot,label="розміщення",taillabel="1",headlabel="0..N",labeldistance=2];Stay->StayService [dir=both,arrowtail=teetee,arrowhead=crowodot,label="замовлення послуг",taillabel="1",headlabel="0..N",labeldistance=2];Service->StayService [dir=both,arrowtail=teetee,arrowhead=crowodot,label="послуга",taillabel="1",headlabel="0..N",labeldistance=2]; }
