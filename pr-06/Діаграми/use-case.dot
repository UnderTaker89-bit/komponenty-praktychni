digraph G { graph [rankdir=LR,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Блокнот — діаграма використання",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; user [shape=plaintext,label="Користувач"]; subgraph cluster_app {label="Блокнот";create [shape=ellipse,label="Створити документ"];open [shape=ellipse,label="Відкрити файл"];edit [shape=ellipse,label="Редагувати текст"];save [shape=ellipse,label="Зберегти файл"];find [shape=ellipse,label="Знайти та замінити"];encode [shape=ellipse,label="Обрати кодування"];close [shape=ellipse,label="Закрити документ"];check [shape=ellipse,label="Перевірити незбережені зміни"];confirm [shape=ellipse,label="Обрати збереження змін"];} user->create [dir=none];user->open [dir=none];user->edit [dir=none];user->save [dir=none];user->find [dir=none];user->encode [dir=none];user->close [dir=none];close->check [style=dashed,label="«include»"];confirm->close [style=dashed,label="«extend»\n[є незбережені зміни]"]; }
