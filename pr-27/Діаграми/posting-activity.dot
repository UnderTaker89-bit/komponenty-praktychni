digraph G { graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Поштове відправлення — діяльність",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; start [shape=point,fillcolor=black];end [shape=doublecircle,label="",width=.22];form [label="Відправник: сформувати відправлення"];valid [shape=diamond,label="Дані коректні?"];fix [label="Виправити дані"];payer [shape=diamond,label="Хто сплачує доставку?"];paynow [label="Відправник: сплатити доставку"];oknow [shape=diamond,label="Оплата успішна?"];deliver [label="Перевізник: доставити до відділення"];due [shape=diamond,label="Доставка коштом отримувача?"];paylater [label="Отримувач: сплатити доставку"];cod [shape=diamond,label="Післяплата за товар?"];goods [label="Отримувач: сплатити товар"];ok [shape=diamond,label="Належні платежі успішні?\nОтримувач приймає товар?"];issue [label="Перевізник: видати відправлення"];transfer [label="Перерахувати післяплату відправнику\nякщо товар оплачено"];back [label="Повернути відправлення\nта облікувати витрати повернення"];cancel [label="Скасувати оформлення"];start->form;form->valid;valid->fix [label="Ні"];fix->form;valid->payer [label="Так"];payer->paynow [label="Відправник"];payer->deliver [label="Отримувач"];paynow->oknow;oknow->deliver [label="Так"];oknow->cancel [label="Ні"];cancel->end;deliver->due;due->paylater [label="Так"];due->cod [label="Ні"];paylater->cod;cod->goods [label="Так"];cod->ok [label="Ні"];goods->ok;ok->issue [label="Так"];ok->back [label="Ні / відмова / строк минув"];issue->transfer;transfer->end;back->end; }
