digraph G { graph [rankdir=TB,bgcolor="white",pad="0.35",nodesep="0.55",ranksep="0.85",label="Банкомат — стани під час зняття готівки",labelloc=t,fontsize=22,fontname="Arial"]; node [shape=box,fontname="Arial",fontsize=14,style="rounded,filled",fillcolor="#f0f5fc",color="#355579",margin="0.18,0.12"]; edge [fontname="Arial",fontsize=12,color="#355579",arrowsize=0.8]; start [shape=point,fillcolor=black];end [shape=doublecircle,label="",width=.22];idle [label="Очікування картки"];pin [label="Введення PIN"];check [label="Перевірка PIN"];menu [label="Вибір суми"];funds [label="Перевірка балансу і купюр"];cash [label="Видача готівки"];returncard [label="Повернення картки"];retain [label="Картку затримано"];error [label="Відмова операції"];start->idle;idle->pin [label="insertCard / attempts=0"];pin->check [label="submitPIN"];check->menu [label="[PIN правильний]"];check->pin [label="[помилка і attempts<2] / attempts++"];check->retain [label="[помилка і attempts=2] / attempts++"];menu->funds [label="submitAmount [сума>0]"];funds->cash [label="[кошти й купюри є] / резервувати суму"];funds->error [label="[відмова / тайм аут]"];cash->returncard [label="cashDispensed / підтвердити списання"];cash->error [label="dispenseFailed / скасувати резерв"];pin->returncard [label="cancel / timeout"];menu->returncard [label="cancel / timeout"];error->returncard [label="показати причину"];returncard->idle [label="cardTaken / очистити сесію"];returncard->retain [label="cardNotTaken / затримати"];retain->end; }
